# Environment variables for daily-journal-api (copy to .env and fill in values)

# Supabase Postgres direct connection string
# Find under: Project Settings → Database → Connection string → URI
# Replace postgres:// with jdbc:postgresql://
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<db>
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<your-supabase-db-password>

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-journal.vercel.app

# Supabase Storage configuration (Service Role Key stays on server only)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
SUPABASE_BUCKET=journal-images
SIGNED_URL_TTL_SECONDS=7200
KEEP_ORIGINALS=false
